# ============================================
# Python 虚拟环境与缓存
# ============================================
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/

# ============================================
# 敏感与运行时配置 (绝不上传)
# ============================================
.env
.env.*
!.env.example
config.json

# ============================================
# 运行时数据与上传文件 (含候选人隐私)
# ============================================
data/store.json
data/*.tmp
uploads/*
!uploads/.gitkeep

# 保留出厂自测预置基线快照
!data/store.baseline.json

# ============================================
# IDE 与操作系统缓存
# ============================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.log
